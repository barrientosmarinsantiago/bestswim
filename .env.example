NEXT_PUBLIC_SITE_URL=https://bestswim.es
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=nfsfxnjygfpnizxeyfod

# One-off setup script only: npm run supabase:configure-social-auth
SUPABASE_ACCESS_TOKEN=
SUPABASE_AUTH_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_FACEBOOK_SECRET=
SUPABASE_AUTH_APPLE_CLIENT_ID=
SUPABASE_AUTH_APPLE_SECRET=

NEXT_PUBLIC_WEEKLY_PRICE_LABEL=
NEXT_PUBLIC_MONTHLY_PRICE_LABEL=
NEXT_PUBLIC_ANNUAL_PRICE_LABEL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Pase semanal: precio de PAGO ÚNICO en Stripe (no recurrente)
STRIPE_WEEKLY_PRICE_ID=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

NEXT_PUBLIC_CONTACT_EMAIL=

# --- SEO / indexación ---
# Codigos que dan Google Search Console y Bing Webmaster Tools al verificar la propiedad.
# Se leen del entorno para no versionarlos y poder rotarlos sin tocar codigo.
# 1 = bloquea buscadores (usar en el dominio de preview de Hostinger, quitar en produccion)
NEXT_PUBLIC_NOINDEX=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Fecha de publicacion (YYYY-MM-DD) que usa el sitemap como lastmod. Si se deja vacia se
# usa la fecha del build, que le dice a Google que todo cambia cada dia y acaba ignorandolo.
NEXT_PUBLIC_BUILD_DATE=
# Importes SIN simbolo para los datos estructurados (deben coincidir con Stripe).
NEXT_PUBLIC_WEEKLY_PRICE_AMOUNT=1
NEXT_PUBLIC_MONTHLY_PRICE_AMOUNT=22
NEXT_PUBLIC_ANNUAL_PRICE_AMOUNT=240
# Perfiles sociales para el sameAs de la organizacion (opcionales).
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_FACEBOOK_URL=
# Clave de IndexNow para avisar a Bing/Yandex al publicar (ver docs/SEO-INDEXACION.md).
INDEXNOW_KEY=

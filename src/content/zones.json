  "ambiguous": [
    {
      "id": "velocidad-sin-tipo",
      "pattern": "velocidad(?!\\s+(máxima|maxima|crítica|critica))",
      "note": "'velocidad' suelta: aclara si es máxima (rojo), crítica (naranja=AEI) o suave (baja). Renombra a una frase exacta para que se coloree bien."
    },
    {
      "id": "anaerobico-sin-tipo",
      "pattern": "anaeróbic[oa](?!\\s+(láctic|alactic|aláctic|lactic))",
      "note": "'anaeróbico' sin tipo: especifica 'láctico' (rojo oscuro) o 'aláctico' (rojo)."
    },
    {
      "id": "vel-abreviado",
      "pattern": "\\bVEL\\b",
      "note": "'VEL' abreviado no se colorea (ambiguo). Usa 'velocidad máxima' o el código de zona correspondiente."
    },
    {
      "id": "zona-fuera-de-rango",
      "pattern": "\\bzona\\s+([67890]|1[0-9])\\b",
      "note": "'zona' con número fuera de 1-5: revisa, solo Z1-Z5 tienen color definido."
    }
  ]
